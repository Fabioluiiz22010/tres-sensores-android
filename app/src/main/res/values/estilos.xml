<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos reaproveitados em todas as telas: letras grandes e botões altos -->
<resources>
    <style name="Socorro" />

    <!-- Textos -->
    <style name="Socorro.Titulo">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/socorro_texto</item>
    </style>

    <style name="Socorro.Subtitulo">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/socorro_texto</item>
    </style>

    <style name="Socorro.Texto">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/socorro_texto</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Socorro.TextoSec">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/socorro_texto_2</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Socorro.Secao">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/socorro_texto_2</item>
    </style>

    <style name="Socorro.Valor">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/socorro_texto</item>
    </style>

    <!-- Cartão branco com borda suave -->
    <style name="Socorro.Card">
        <item name="cardBackgroundColor">@color/socorro_card</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">20dp</item>
        <item name="strokeColor">@color/socorro_borda</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Botões: no mínimo 60dp de altura, texto grande e sem CAIXA ALTA -->
    <style name="Socorro.Botao">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/socorro_primaria</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Socorro.BotaoContorno" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/socorro_primaria</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="strokeColor">@color/socorro_primaria</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Socorro.BotaoTexto" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/socorro_primaria</item>
    </style>

    <!-- Campos de texto grandes -->
    <style name="Socorro.Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/socorro_primaria</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/socorro_primaria</item>
        <item name="hintTextAppearance">@style/Socorro.Dica</item>
        <item name="helperTextTextAppearance">@style/Socorro.Ajuda</item>
        <item name="errorTextAppearance">@style/Socorro.Ajuda</item>
    </style>

    <style name="Socorro.CampoTexto">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/socorro_texto</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="Socorro.Dica" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Socorro.Ajuda" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Barra de cima e menu de baixo -->
    <style name="Socorro.BarraTitulo" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Socorro.BarraSubtitulo" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#D1FAE5</item>
    </style>

    <style name="Socorro.MenuTexto" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>